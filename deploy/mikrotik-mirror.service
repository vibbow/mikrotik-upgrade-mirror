[Unit]
Description=MikroTik local-update package mirror (Winbox)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mikrotik-mirror
# The server only serves files; packages are pushed with mirror-push.
# Accounts: stable/stable and longterm/longterm (password = username).
ExecStart=/opt/mikrotik-mirror/mikrotik-mirror \
  --listen 0.0.0.0:8291 \
  --stable-dir /opt/mikrotik-mirror/packages/stable \
  --longterm-dir /opt/mikrotik-mirror/packages/long-term
Restart=on-failure
RestartSec=10
# hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
