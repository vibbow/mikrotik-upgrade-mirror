# build artifacts (the scripts in scripts/ rebuild them on every run)
*.exe
/mikrotik-mirror
/mirror-push
/mirror-upgrade
/winbox-capture
/dist/

# local package store (synced/pushed at runtime, not source)
/packages/
*.npk

# research captures
*.pcap
research/*.jsonl
research/real_objects.json
research/vectors.json

# winbox-capture output: contains router configuration and the login password
capture*.jsonl
capture*.txt
/research/captures/

# local Claude Code state (memory holds secrets; settings.local is personal)
/.claude/memory/
/.claude/settings.local.json

# personal ignore list for mirror-upgrade (copy scripts/ignore.example.txt)
/scripts/ignore.txt

# personal settings (server, proxy, address book path): copy scripts/config.example.ps1
/scripts/config.ps1
